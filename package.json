{
  "name": "static_chess",
  "private": true,
  "version": "0.1.0",
  "description": "Dev tooling for Static Chess (lint/test only)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "jest --runInBand",
    "coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "js/**/*.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.3.3"
  }
}
