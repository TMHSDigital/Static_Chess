{
  "name": "static_chess",
  "private": true,
  "version": "0.2.0",
  "description": "Dev tooling for Static Chess (lint/test only)",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "jest --runInBand",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "<rootDir>/tests/helpers/jsdom-environment.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/browser/"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "sw.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "branches": 90,
        "functions": 97,
        "lines": 97
      },
      "./js/rules.js": {
        "branches": 98
      },
      "./js/notation.js": {
        "branches": 98
      },
      "./js/saved-game.js": {
        "branches": 98
      },
      "./js/game-store.js": {
        "branches": 97
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.3.3"
  }
}
